# WinnersBet payments API — environment template
# Copy to .env for local runs, or set these as environment variables on your host.

# Payment mode: mock = simulated, live = real money via provider
PAYMENT_MODE=live

# Provider for live mode: lightio | sonicpesa
PAYMENT_PROVIDER=sonicpesa

# --- SonicPesa (Push USSD) ---
SONIC_API_KEY=your_sonic_api_key_here
SONIC_SECRET_KEY=your_sonic_secret_key_here
# You can leave this on the default SonicPesa API base if unsure:
# SONIC_BASE_URL=https://api.sonicpesa.com

# Port the server listens on (hosts like Render/Railway usually set this)
PORT=4000